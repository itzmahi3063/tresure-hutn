# Telegram bot token from @BotFather
BOT_TOKEN=

# Your Telegram numeric user ID — only this ID can open /admin
# (put your real ID only in your actual .env / Vercel dashboard, never here)
ADMIN_USER_ID=

# MongoDB Atlas connection string
MONGODB_URI=

# Random long secret for signing session JWTs (not the bot token)
JWT_SECRET=

# Diamond -> USDT conversion rate
DIAMOND_TO_USDT_RATE=0.00004
